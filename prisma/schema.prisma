generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_DATABASE_URL")
  directUrl = env("SUPABASE_DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique @map("clerk_id")
  firstName String   @default("") @map("first_name")
  lastName  String   @default("") @map("last_name")
  phone     String   @default("")
  email     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model House {
  id             String       @id @default(cuid())
  hId            String       @unique @map("h_id")
  hZone          String       @default("pattaya") @map("h_zone")
  hBedroom       Int          @map("h_bedroom")
  hToilet        Int          @map("h_toilet")
  hFarsea        String       @default("") @map("h_farsea")
  price          Int
  people         Int
  imgName        String       @default("") @map("img_name")
  swim           String       @default("chlorine")
  wifi           Boolean      @default(false)
  grill          Boolean      @default(false)
  pet            Boolean      @default(false)
  karaoke        Boolean      @default(false)
  jacuzzi        Boolean      @default(false)
  snooker        Boolean      @default(false)
  discotech      Boolean      @default(false)
  slider         Boolean      @default(false)
  billard        Boolean      @default(false)
  swimmingKid    Boolean      @default(false) @map("swimming_kid")
  bath           Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  category       String       @default("NORMAL")
  images         String[]     @default([])
  manualOverride Boolean      @default(false) @map("manual_override")
  description    String       @default("")
  isActive       Boolean      @default(true) @map("is_active")
  isPublished    Boolean      @default(true) @map("is_published")
  name           String       @default("")
  basePrices     BasePrice?
  bookings       Booking[]
  holidays       Holiday[]
  detail         HouseDetail?

  @@map("houses")
}

model HouseDetail {
  id              String   @id @default(cuid())
  houseId         String   @unique @map("house_id")
  checkin         String   @default("14:00") @map("h_time_checkin")
  checkout        String   @default("12:00") @map("h_time_checkout")
  extra           Int      @default(0)
  insurance       Int      @default(0)
  peopleMax       Int      @default(0) @map("people_max")
  location        String   @default("")
  sea             String   @default("")
  parking         String   @default("") @map("h_parking")
  kitchen         String   @default("") @map("h_kitchen_ware")
  additionalCosts String   @default("") @map("h_additional_costs")
  moreDetail      String   @default("") @map("h_moredetail")
  bedroomDetail   String   @default("") @map("h_bedroom_detail")
  alert           String   @default("") @map("h_alert")
  updatedAt       DateTime @updatedAt @map("updated_at")
  amenities       String[] @default([])
  fullDescription String   @default("") @map("full_description")
  mapUrl          String   @default("") @map("map_url")
  nearbyPlaces    String   @default("") @map("nearby_places")
  rules           String   @default("")
  house           House    @relation(fields: [houseId], references: [hId])

  @@map("house_details")
}

model Booking {
  id        String   @id @default(cuid())
  houseId   String   @map("house_id")
  checkIn   DateTime @map("book_checkin")
  checkOut  DateTime @map("book_checkout")
  bookType  String   @default("guest") @map("book_type")
  createdAt DateTime @default(now()) @map("created_at")
  house     House    @relation(fields: [houseId], references: [hId])

  @@map("bookings")
}

model Holiday {
  id        String   @id @default(cuid())
  houseId   String   @map("house_id")
  start     DateTime
  end       DateTime
  type      String   @default("holiday")
  price     Int      @default(0)
  people    Int      @default(0)
  alert     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  house     House    @relation(fields: [houseId], references: [hId])

  @@map("holidays")
}

model Article {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?  @map("image_url")
  published Boolean  @default(true)
  author    String   @default("Admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

model BasePrice {
  id       String @id @default(cuid())
  houseId  String @unique @map("house_id")
  priceSun Int    @default(0) @map("price_sun")
  priceMon Int    @default(0) @map("price_mon")
  priceTue Int    @default(0) @map("price_tue")
  priceWed Int    @default(0) @map("price_wed")
  priceThu Int    @default(0) @map("price_thu")
  priceFri Int    @default(0) @map("price_fri")
  priceSat Int    @default(0) @map("price_sat")
  house    House  @relation(fields: [houseId], references: [hId])

  @@map("base_prices")
}

model LineUser {
  id              String               @id @default(cuid())
  lineUserId      String               @unique @map("line_user_id")
  displayName     String               @default("") @map("display_name")
  pictureUrl      String?              @map("picture_url")
  phone           String               @default("")
  firstName       String               @default("") @map("first_name")
  lastName        String               @default("") @map("last_name")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  bookingRequests LineBookingRequest[]

  @@map("line_users")
}

model LineBookingRequest {
  id         String   @id @default(cuid())
  lineUserId String   @map("line_user_id")
  houseId    String   @map("house_id")
  checkIn    DateTime @map("check_in")
  checkOut   DateTime @map("check_out")
  guests     Int      @default(1)
  totalPrice Int      @default(0) @map("total_price")
  phone      String   @default("")
  firstName  String   @default("") @map("first_name")
  lastName   String   @default("") @map("last_name")
  notes      String   @default("")
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  lineUser   LineUser @relation(fields: [lineUserId], references: [lineUserId])

  @@map("line_booking_requests")
}
